# ==============================================================================
# BONITA DOCKER COMPOSE CONFIGURATION
# ==============================================================================
# Copy this file to .env and adjust the values for your environment
#
# IMPORTANT: This file contains sensitive credentials. Never commit .env to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# DOCKER IMAGES
# ------------------------------------------------------------------------------
# Bonita Runtime Image
BONITA_IMAGE_REPOSITORY=bonitasoft.jfrog.io/docker/bonita-subscription
BONITA_IMAGE_TAG=2025.2-u5

# UI Builder Image
UI_BUILDER_IMAGE_REPOSITORY=bonitasoft.jfrog.io/docker/bonita-ui-builder
UI_BUILDER_IMAGE_TAG=1.3.9

# UI Proxy Image
UI_PROXY_IMAGE_REPOSITORY=bonitasoft.jfrog.io/docker/bonita-ui-proxy
UI_PROXY_IMAGE_TAG=1.3.9

# ------------------------------------------------------------------------------
# PORTS CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL port (default: 5432)
POSTGRES_PORT=5432

# Bonita Runtime port (default: 8080)
BONITA_PORT=8080

# Hazelcast port for clustering (default: 5701)
HAZELCAST_PORT=5701

# UI Builder port (default: 8081)
UI_BUILDER_PORT=8081

# UI Proxy port - main entry point (default: 80)
UI_PROXY_PORT=80

# ------------------------------------------------------------------------------
# POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL root password
POSTGRES_ROOT_PASSWORD=testpassword

# Bonita database configuration
DB_VENDOR=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bonita
DB_USER=bonitauser
DB_PASSWORD=myDbSecret

# Business Data Model (BDM) database configuration
BDM_DB_NAME=bizdata
BDM_DB_USER=bizuser
BDM_DB_PASSWORD=myBdmSecret

# ------------------------------------------------------------------------------
# DATABASE CONNECTION POOLS
# ------------------------------------------------------------------------------
# Bonita database connection pool
BONITA_POOL_INITIAL_SIZE=2
BONITA_POOL_MAX_TOTAL=10
BONITA_POOL_MIN_IDLE=2
BONITA_POOL_MAX_IDLE=10

# BDM database connection pool
BDM_POOL_INITIAL_SIZE=1
BDM_POOL_MAX_TOTAL=5
BDM_POOL_MIN_IDLE=1
BDM_POOL_MAX_IDLE=5

# ------------------------------------------------------------------------------
# BONITA CREDENTIALS
# ------------------------------------------------------------------------------
# Tenant Administrator (default user for Bonita Portal)
TENANT_USERNAME=admin
TENANT_PASSWORD=myAdminSecret

# Platform Administrator (for platform management)
PLATFORM_USERNAME=pflogin
PLATFORM_PASSWORD=myPfSecret

# Monitoring user (for health checks and monitoring endpoints)
MONITORING_USERNAME=monitoring
MONITORING_PASSWORD=myMonitoringSecret

# ------------------------------------------------------------------------------
# BONITA RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Timezone (e.g., Europe/Paris, America/New_York, UTC)
TIMEZONE=Europe/Paris

# Cluster mode (true/false) - Enable for multi-instance deployments
CLUSTER_MODE=false

# Remote IP valve (true/false) - Enable when behind a reverse proxy
REMOTE_IP_ENABLED=true

# Session duration in milliseconds (default: 3600000 = 1 hour)
SESSION_DURATION_MS=3600000

# Session duration in seconds (for cluster config, should match above)
SESSION_DURATION_SEC=3600

# Second level cache (true/false) - Hibernate second-level cache
USE_SECOND_LEVEL_CACHE=false

# HTTP max threads (leave empty for default)
HTTP_MAX_THREADS=

# Additional Java options (optional)
JAVA_OPTS_EXTRA=

# ------------------------------------------------------------------------------
# ACCESS LOGS CONFIGURATION
# ------------------------------------------------------------------------------
# Enable stdout access logs (true/false)
ACCESSLOGS_STDOUT=true

# Enable file access logs (true/false)
ACCESSLOGS_FILES=false

# ------------------------------------------------------------------------------
# UI BUILDER CONFIGURATION
# ------------------------------------------------------------------------------
# Enable development mode for UI Builder (true/false)
UI_BUILDER_DEV_MODE=false

# ------------------------------------------------------------------------------
# NGINX PROXY CONFIGURATION
# ------------------------------------------------------------------------------
# Log all requests (1=true, 0=false)
NGINX_ACCESS_LOG_ALL=1

# NGINX error log level (debug, info, notice, warn, error, crit, alert, emerg)
NGINX_ERROR_LOG_LEVEL=error

# ------------------------------------------------------------------------------
# HIGH AVAILABILITY CLUSTERING
# ------------------------------------------------------------------------------
# Enable cluster mode for High Availability deployment with 2+ instances
# Set to 'true' to enable Hazelcast clustering between Bonita Runtime instances
# Set to 'false' for single instance deployment
CLUSTER_MODE=true

# Cluster group name - All instances must use the same name
CLUSTER_GROUP_NAME=bonita-docker-cluster

# Hazelcast discovery method (tcpip for Docker Compose)
# TCP/IP discovery uses static member list defined in cluster-config/bonita-platform-sp-cluster-custom.properties
HAZELCAST_DISCOVERY_METHOD=tcpip

# Static cluster members (for reference - actual config in cluster-config/)
# Format: hostname:port,hostname:port
# Default for docker-compose setup: bonita-runtime-1:5701,bonita-runtime-2:5701
HAZELCAST_MEMBERS=bonita-runtime-1:5701,bonita-runtime-2:5701

# Note: For single instance mode, comment out bonita-runtime-2 in docker-compose.yml
# and set CLUSTER_MODE=false

# ------------------------------------------------------------------------------
# ADVANCED CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# Usage metrics (requires subscription)
# USAGE_METRICS_ENABLED=false
# USAGE_METRICS_SUBSCRIPTION_ID=
# USAGE_METRICS_RUNTIME_ID=
# USAGE_METRICS_ACCOUNT_NAME=
# USAGE_METRICS_CONNECTION_URL=
# USAGE_METRICS_CONNECTION_TIMEOUT=
# USAGE_METRICS_CONNECTION_AUTHENTICATION=

# HTTP API (internal API access)
# HTTP_API_ENABLED=false
# HTTP_API_USERNAME=
# HTTP_API_PASSWORD=

# XA Transaction timeout (seconds)
# TRANSACTION_XA_TIMEOUT=

# Heap dump path
# HEAP_DUMP_PATH=/opt/bonita_run
